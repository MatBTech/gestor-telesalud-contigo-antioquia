# Copie este archivo como .env y ajuste los valores a su equipo.

# Puerto donde corre la API y entorno de ejecucion.
PORT=3000
NODE_ENV=development

# URL del frontend, se usa para configurar CORS.
FRONTEND_URL=http://localhost:4200

# Conexion a PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=telesalud_antioquia

# Clave para firmar los tokens JWT. Debe ser larga y secreta.
JWT_SECRET=cambie_esta_clave_por_una_cadena_larga_y_aleatoria
# Duracion del token en segundos (28800 = 8 horas, una jornada laboral).
JWT_EXPIRACION_SEGUNDOS=28800

# API externa de geolocalizacion. Nominatim exige un User-Agent que identifique la aplicacion.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=GestorTelesaludContigoAntioquia/1.0 (proyecto academico)

# Carpeta local donde se guardan las actas y evidencias.
UPLOADS_DIR=./uploads

# Usuario administrador que se crea automaticamente la primera vez.
ADMIN_NOMBRE=Administrador General
ADMIN_CORREO=admin@telesalud.local
ADMIN_PASSWORD=Admin12345
